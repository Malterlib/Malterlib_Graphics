Property.CMakeOutputPath_freetype: string = `@('.'->MakeAbsolute())`->MakeAbsolute()
%Target "Lib_freetype_freetype"
{
	Compile
	{
		!!Compile.Type "WindowsResource"
		SearchPath += [
			`@('.'->MakeAbsolute())/include`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_freetype`->MakeAbsolute(),
			`@('../../../../External/freetype'->MakeAbsolute())/include`->MakeAbsolute(),
			`@('.'->MakeAbsolute())/include/freetype/config`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_freetype`->MakeAbsolute()
		]
		PreprocessorDefines += [
			"FT2_BUILD_LIBRARY",
			"_CRT_NONSTDC_NO_WARNINGS",
			"_CRT_SECURE_NO_WARNINGS"
		]
	}
	Compile
	{
		!!Compile.Type "C"
		SearchPath += [
			`@('.'->MakeAbsolute())/include`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_freetype`->MakeAbsolute(),
			`@('../../../../External/freetype'->MakeAbsolute())/include`->MakeAbsolute(),
			`@('.'->MakeAbsolute())/include/freetype/config`->MakeAbsolute(),
			`@(CMakeIntermediateDirectory)/External_freetype`->MakeAbsolute()
		]
		PreprocessorDefines += [
			"FT2_BUILD_LIBRARY",
			"_CRT_NONSTDC_NO_WARNINGS",
			"_CRT_SECURE_NO_WARNINGS"
		]
	}
	Property.MalterlibTargetNameType "Normal"
	Compile.AllowNonExisting true
	Target.Group "External/freetype"
	{
		!!Target.Group undefined
	}
	Target.Type "StaticLibrary"
	Target.BaseName "freetype_freetype"
	Target.BaseFileName "freetype"
	%Group "include"
	{
		%Group "freetype"
		{
			%File `@('../../../../External/freetype'->MakeAbsolute())/include/freetype/freetype.h`
			{
